config_version=5

[application]

config/name="BrawlCrypt"
config/description="BrawlCrypt: a local-multiplayer 2D gothic platform fighter. Two players, one keyboard (or one controller each)."
config/version="0.1.0"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

